index 0000000..b6d027d
--- /dev/null
+++ b/src/core/context-function-calls.ts
@@ -0,0 +1,119 @@
+import type { CodeMapReadFirstItem } from "./context-builder.ts";
+import { isRegexStart, regexEnd } from "./javascript-syntax.ts";
+
+interface Token { value: string; line: number }
+
+// Reject ambiguous slash syntax rather than infer a call from an unparsed literal.
+function tokens(source: string): Token[] | undefined {
+  const result: Token[] = [];
+  let line = 1;
+  for (let i = 0; i < source.length;) {
+    const char = source[i];
+    if (/\s/.test(char)) { if (char === "\n") line++; i++; continue; }
+    if (source.startsWith("//", i)) { while (i < source.length && source[i] !== "\n") i++; continue; }
+    if (source.startsWith("/*", i)) {
+      const end = source.indexOf("*/", i + 2);
+      if (end < 0) return undefined;
+      line += source.slice(i, end + 2).split("\n").length - 1;
+      i = end + 2; continue;
+    }
+    if (char === "'" || char === '"' || char === "`") {
+      const quote = char;
+      let closed = false;
+      const begin = i;
+      for (i++; i < source.length; i++) {
+        if (source[i] === "\n") line++;
+        if (source[i] === "\\") { if (source[i + 1] === "\n") line++; i++; continue; }
+        if (source[i] === quote) { i++; closed = true; break; }
+      }
+      if (!closed) return undefined;
+      // Only simple references inside templates are masked safely here. Complex
+      // interpolation (including nested templates) disables call inference.
+      if (quote === "`" && source.slice(begin + 1, i - 1).replace(/\$\{[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*\}/g, "").includes("${")) return undefined;
+      continue;
+    }
+    if (char === "/") {
+      const lineStart = source.lastIndexOf("\n", i - 1) + 1;
+      const lineText = source.slice(lineStart).split("\n")[0];
+      const offset = i - lineStart;
+      if (!isRegexStart(lineText, offset)) return undefined;
+      const end = regexEnd(lineText, offset);
+      if (end === offset) return undefined;
+      i = lineStart + end + 1;
+      while (/[a-z]/i.test(source[i] ?? "") && i < source.length) i++;
+      continue;
+    }
+    const identifier = /^[A-Za-z_$][\w$]*/.exec(source.slice(i));
+    if (identifier) { result.push({ value: identifier[0], line }); i += identifier[0].length; }
+    else { result.push({ value: char, line }); i++; }
+  }
+  return result;
+}
+
+function closing(ts: Token[], start: number, open: string, close: string): number {
+  let depth = 0;
+  for (let i = start; i < ts.length; i++) {
+    if (ts[i].value === open) depth++;
+    if (ts[i].value === close && --depth === 0) return i;
+  }
+  return -1;
+}
+
+export interface LocalCallCandidate { item: CodeMapReadFirstItem; count: number; coverage: number }
+
+export function localCallCandidates(source: string, seeds: CodeMapReadFirstItem[], functions: CodeMapReadFirstItem[], query: string): LocalCallCandidate[] {
+  const ts = tokens(source);
+  if (!ts || ts.some((t, i) => ["with", "eval"].includes(t.value) && ts[i + 1]?.value === "(")) return [];
+  const terms = [...new Set(query.toLowerCase().match(/[a-z0-9]+/g) ?? [])];
+  const ranked: Array<{ item: CodeMapReadFirstItem; count: number; coverage: number }> = [];
+  let depth = 0;
+  for (let i = 0; i < ts.length; i++) {
+    const token = ts[i];
+    if (token.value === "{") depth++;
+    if (token.value === "}") depth--;
+    if (depth !== 0 || token.value !== "function" || !/^[A-Za-z_$][\w$]*$/.test(ts[i + 1]?.value ?? "") || ts[i + 2]?.value !== "(") continue;
+    const previous = ts[i - 1];
+    if (previous && previous.line === token.line && ![";", "}", "export", "default", "async"].includes(previous.value)) continue;
+    if (["=", "(", ":", ","].includes(previous?.value ?? "") || (previous?.value === "async" && ["=", "(", ":", ","].includes(ts[i - 2]?.value ?? ""))) continue;
+    const name = ts[i + 1].value;
+    const paramsEnd = closing(ts, i + 2, "(", ")");
+    if (paramsEnd < 0 || ts[paramsEnd + 1]?.value !== "{") continue;
+    const bodyEnd = closing(ts, paramsEnd + 1, "{", "}");
+    if (bodyEnd < 0) continue;
+    const item = functions.find(f => f.startLine === token.line && f.endLine === ts[bodyEnd].line && f.kind === "function");
+    if (!item || seeds.some(s => s.path === item.path && s.startLine <= item.startLine && s.endLine >= item.endLine)) continue;
+    let count = 0;
+    let unsafe = false;
+    for (let j = 0; j < ts.length; j++) {
+      if (ts[j].value !== name || j === i + 1) continue;
+      if (ts[j - 1]?.value === ".") continue;
+      // Every other bare use must be a call. This rejects rebinding, parameters,
+      // destructuring, nested declarations and callbacks passed by reference.
+      if (ts[j + 1]?.value !== "(" || ["function", "new"].includes(ts[j - 1]?.value ?? "")) { unsafe = true; break; }
+      const end = closing(ts, j + 1, "(", ")");
+      if (end < 0 || ts[end + 1]?.value === "{") { unsafe = true; break; }
+      if (seeds.some(s => ts[j].line >= s.startLine && ts[j].line <= s.endLine)) count++;
+    }
+    const body = ts.slice(paramsEnd + 2, bodyEnd).map(t => t.value.toLowerCase()).join(" ");
+    const coverage = terms.filter(term => body.includes(term)).length;
+    if (!unsafe && count > 0 && coverage > 0) ranked.push({ item, count, coverage });
+  }
+  return ranked.map(row => ({ ...row, item: {
+    ...row.item,
+    reasons: [{ kind: "local_call", label: "Direct same-file function call", sourcePath: row.item.path, targetPath: row.item.path }],
+  } }));
+}
+
+export function prioritizeFunctionContext(baseline: CodeMapReadFirstItem[], seeds: CodeMapReadFirstItem[], callees: CodeMapReadFirstItem[], limit: number): CodeMapReadFirstItem[] {
+  if (!baseline.length) return baseline;
+  const bytes = (item: CodeMapReadFirstItem) => Buffer.byteLength("text" in item ? item.text : "");
+  const budget = baseline.reduce((sum, item) => sum + bytes(item), 0);
+  const selected = [baseline[0]];
+  let used = bytes(baseline[0]);
+  for (const item of [...seeds.slice(0, 2), ...callees.slice(0, 1), ...baseline.slice(1)]) {
+    if (selected.some(existing => existing.path === item.path && existing.startLine <= item.startLine && existing.endLine >= item.endLine)) continue;
+    if (selected.length >= limit || used + bytes(item) > budget) continue;
+    selected.push(item); used += bytes(item);
+  }
+  return selected;
+}
