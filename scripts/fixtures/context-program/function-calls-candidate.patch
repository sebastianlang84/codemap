@@ -0,0 +1,49 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { localCallCandidates, prioritizeFunctionContext } from "../src/core/context-function-calls.ts";
+import type { CodeMapReadFirstItem } from "../src/core/context-builder.ts";
+
+function item(text: string, startLine: number, path = "lib/runtime.js"): CodeMapReadFirstItem {
+  return { path, language: "javascript", kind: "function", startLine, endLine: startLine + text.split("\n").length - 1, text, snippet: text };
+}
+function calls(body: string, prefix = "", declaration = "function deliver () { return payload }") {
+  const seed = item(`function entry () { ${body} }`, prefix ? 2 : 1);
+  const callee = item(declaration, prefix ? 3 : 2);
+  return localCallCandidates([prefix, "text" in seed ? seed.text : "", declaration].filter(Boolean).join("\n"), [seed], [callee], "payload");
+}
+
+test("direct calls carry local evidence and count actual invocations", () => {
+  const result = calls("deliver(); deliver()");
+  assert.equal(result.length, 1);
+  assert.equal(result[0].count, 2);
+  assert.equal(result[0].item.reasons?.[0].kind, "local_call");
+});
+
+test("literal and property references never become direct calls", () => {
+  for (const body of ["'deliver()'", '"deliver()"', "`deliver()`", "/* deliver() */", "// deliver()\n", "const re = /deliver\\(\\)/", "object.deliver()", "object?.deliver()", "new deliver()"])
+    assert.equal(calls(body).length, 0, body);
+  assert.equal(calls("deliver()", "const note = `${name} deliver()`").length, 1);
+  assert.equal(calls("deliver()", "const note = `${unknown()}`").length, 0);
+});
+
+test("shadowing, declarations, rebinding and dynamic scope disable evidence", () => {
+  for (const body of ["const deliver = other; deliver()", "function nested(deliver) { deliver() }", "function deliver() {} ; deliver()", "const { deliver } = other; deliver()", "try {} catch(deliver) { deliver() }", "const nested = deliver => deliver()", "deliver = other; deliver()", "with (object) { deliver() }", "eval(code); deliver()", "const obj = { deliver() {} }; deliver()"])
+    assert.equal(calls(body).length, 0, body);
+  assert.equal(calls("deliver()", "", "const value = function deliver () { return payload }").length, 0);
+  assert.equal(calls("deliver()", "", "const value = async function deliver () { return payload }").length, 0);
+});
+
+test("only query-supported same-file indexed declarations are eligible", () => {
+  assert.equal(calls("deliver()", "", "function deliver () { return unrelated }").length, 0);
+  assert.equal(calls("deliver()", "", "if (ready) { function deliver () { return payload } }").length, 0);
+});
+
+test("selection preserves first excerpt, count and actual bytes", () => {
+  const first = item("function a() {}", 1);
+  const second = item("function longer() { return 123456789 }", 2, "b.js");
+  const seed = item("function seed() {}", 4);
+  const selected = prioritizeFunctionContext([first, second], [seed], [], 2);
+  assert.deepEqual(selected, [first, seed]);
+  assert.deepEqual(prioritizeFunctionContext([first], [second], [], 8), [first]);
+  assert.deepEqual(prioritizeFunctionContext([first, second], [first], [], 2), [first, second]);
+});
