+export function restoreMissingFunctionHits(baseline: CodeMapReadFirstItem[], functions: CodeMapReadFirstItem[], limit: number): CodeMapReadFirstItem[] {
+  const covers = (outer: CodeMapReadFirstItem, inner: CodeMapReadFirstItem) => outer.path === inner.path && outer.startLine <= inner.startLine && outer.endLine >= inner.endLine;
