diff --git a/tests/context-missing-hits.test.ts b/tests/context-missing-hits.test.ts
new file mode 100644
index 0000000..8ada745
--- /dev/null
+++ b/tests/context-missing-hits.test.ts
@@ -0,0 +1,41 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { restoreMissingFunctionHits } from "../src/core/context-builder.ts";
+import type { CodeMapReadFirstItem } from "../src/core/context-builder.ts";
+
+function item(path: string, text: string, startLine = 1, endLine = startLine): CodeMapReadFirstItem {
+  return { path, text, startLine, endLine, language: "javascript", kind: "function", snippet: text,
+    reasons: [{ kind: "import", label: "existing evidence" }] };
+}
+
+test("covered functions leave the original items, reasons and order untouched", () => {
+  const baseline = [item("a.js", "first", 1, 8), item("b.js", "second", 3, 10)];
+  assert.equal(restoreMissingFunctionHits(baseline, [item("b.js", "inner", 5, 7)], 8), baseline);
+  assert.equal(restoreMissingFunctionHits(baseline, [], 8), baseline);
+});
+
+test("missing functions follow the first item and retain baseline relative order and evidence", () => {
+  const baseline = [item("a.js", "first"), item("b.js", "second"), item("c.js", "third")];
+  const addition = item("new.js", "new");
+  const selected = restoreMissingFunctionHits(baseline, [addition], 3);
+  assert.deepEqual(selected, [baseline[0], addition, baseline[1]]);
+  assert.equal(selected[0], baseline[0]);
+  assert.equal(selected[2].reasons, baseline[1].reasons);
+});
+
+test("actual UTF-8 bytes and excerpt limits constrain additions", () => {
+  const baseline = [item("a.js", "a"), item("b.js", "bb")];
+  assert.equal(restoreMissingFunctionHits(baseline, [item("new.js", "€")], 8), baseline);
+  assert.equal(restoreMissingFunctionHits(baseline, [item("new.js", "x")], 1), baseline);
+  assert.deepEqual(restoreMissingFunctionHits(baseline, [item("new.js", "é")], 8), [baseline[0], item("new.js", "é")]);
+});
+
+test("at most two missing functions are considered, with contained additions suppressed", () => {
+  const baseline = [item("a.js", "a"), item("b.js", "long baseline")];
+  const first = item("x.js", "xx", 1, 10);
+  const second = item("y.js", "yy");
+  const third = item("z.js", "zz");
+  const selected = restoreMissingFunctionHits(baseline, [first, second, third], 8);
+  assert.deepEqual(selected, [baseline[0], first, second]);
+  assert.deepEqual(restoreMissingFunctionHits(baseline, [first, item("x.js", "inside", 2, 3)], 8), [baseline[0], first]);
+});
